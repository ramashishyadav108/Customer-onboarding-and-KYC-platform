{
  "name": "OnboardX",
  "description": "Customer onboarding and KYC platform for a bank: lead capture, KYC document workflow, stubbed classification, AML/PEP screening, versioned risk-band classification, compliance-officer review with audited overrides, stubbed account creation, admin reports. Synthetic data only.",
  "stack": {
    "backend": { "language": "python", "version": "3.12", "framework": "fastapi", "package_manager": "pip (venv)", "linter": "ruff", "typechecker": "mypy", "test_runner": "pytest" },
    "frontend": { "language": "typescript", "framework": "react", "bundler": "vite", "package_manager": "npm", "linter": "eslint", "typechecker": "tsc", "test_runner": "vitest" },
    "database": { "primary": "postgresql", "secondary": "sqlite (tests)" },
    "deployment": { "method": "local", "services": ["backend", "frontend"] }
  },
  "evaluation": {
    "api_base_url": "http://localhost:8000",
    "ui_base_url": "http://localhost:3000",
    "health_check": "http://localhost:8000/health",
    "design_score_threshold": 6,
    "design_max_iterations": 5,
    "test_corpus_dir": "tests/fixtures"
  },
  "execution": {
    "default_mode": "full",
    "max_self_heal_attempts": 3,
    "max_auto_iterations": 50,
    "coverage_threshold": 80,
    "session_chaining": true,
    "agent_team_size": "auto",
    "teammate_model": "sonnet"
  },
  "verification": {
    "mode": "local",
    "health_check": { "url": "http://localhost:8000/health", "retries": 5, "backoff_seconds": 2 },
    "local": { "backend_url": "http://localhost:8000", "frontend_url": "http://localhost:3000", "start_commands": [] }
  }
}
