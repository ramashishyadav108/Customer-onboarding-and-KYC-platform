# Synthetic dev values only. Copy to .env (git-ignored); never commit real secrets.
DATABASE_URL=sqlite://
JWT_SECRET=dev-only-not-a-secret
LOG_LEVEL=INFO
# Who approves a case: auto (clean LOW-risk cases approved automatically, AC-07) or manual (a compliance officer approves every case)
# REVIEW_POLICY=auto
# Admin sign-up: approval (an admin must approve it) or open (anyone can sign up as admin; local demos only)
# ADMIN_SIGNUP=approval
